	"sources": {
		"intro": "Limina is built on open data and open tools",
		"mapterhorn": {
			"role": "Elevation data",
			"detail": "Ground heights worldwide. These give the terrain its shape, and are what the app measures against to work out which summits are visible from where you stand and when the sun clears a ridge."
		},
		"openstreetmap": {
			"role": "Names and positions",
			"detail": "The name, position and recorded height of every summit, mountain range, ridge and hill the app labels."
		},
		"carto": {
			"role": "Map tiles",
			"detail": "The dark map imagery used by the flat map when choosing a viewpoint, drawn from OpenStreetMap data."
		},
		"nominatim": {
			"role": "Place search",
			"detail": "A search service run by OpenStreetMap. It converts a typed place name into coordinates the app can move to."
		},
		"maplibre": {
			"role": "Map rendering",
			"detail": "Renders the flat map, and handles panning, zooming and animated moves."
		},
		"milkyWay": {
			"role": "Milky Way shape",
			"detail": "Contour data describing the outline of the Milky Way, traced by José R. Vieira. The app reads it from the copy published with Olaf Frohn’s d3-celestial."
		}
	}
