{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "limina": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "maplibre-gl-worker.mjs",
                "input": "node_modules/maplibre-gl/dist",
                "output": "/"
              },
              {
                "glob": "maplibre-gl-shared.mjs",
                "input": "node_modules/maplibre-gl/dist",
                "output": "/"
              },
              {
                "glob": "{peaks.php,timezone.php,db.php,config.php}",
                "input": "server",
                "output": "/api"
              },
              {
                "glob": "peaks.sqlite",
                "input": "server/data",
                "output": "/api/data"
              },
              {
                "glob": ".htaccess",
                "input": "deploy",
                "output": "/"
              }
            ],
            "styles": [
              "src/styles/styles.scss",
              "public/fonts/fontello/css/fontello.css",
              "./node_modules/maplibre-gl/dist/maplibre-gl.css"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "src/styles/abstracts"
              ]
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.development.ts"
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "limina:build:production"
            },
            "development": {
              "buildTarget": "limina:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
