# Drop the contents of dist/limina/browser into the web root and the app runs as
# it stands: the API sits in api/, and everything else is the single page.

<IfModule mod_rewrite.c>
	RewriteEngine On

	# Whatever folder this lands in, deep links resolve against it.
	RewriteBase /

	# The API and any real file are served as they are.
	RewriteCond %{REQUEST_URI} ^api/ [OR]
	RewriteCond %{REQUEST_FILENAME} -f [OR]
	RewriteCond %{REQUEST_FILENAME} -d
	RewriteRule ^ - [L]

	# Everything else is a route inside the app.
	RewriteRule ^ index.html [L]
</IfModule>

# The database is read through the API, never over the web.
<FilesMatch "\.(sqlite|sqlite-shm|sqlite-wal)$">
	Require all denied
</FilesMatch>

<IfModule mod_mime.c>
	AddType application/wasm .wasm
	AddType image/webp .webp
</IfModule>

<IfModule mod_deflate.c>
	AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
